# ============================================================================
# CLAEX — Modelo de Variáveis de Ambiente (.env.example)
# ============================================================================
# Como usar:
#   1. Copie este arquivo para ".env":   cp .env.example .env
#   2. Preencha os valores reais apenas na sua máquina ou nos GitHub Secrets.
#   3. O arquivo ".env" está no .gitignore e NUNCA sobe para o GitHub.
# ============================================================================

# --- Servidor ---
PORT=8081
# Segredo usado para assinar cookies de sessão (gere com: openssl rand -base64 48)
SECRET_KEY=troque-por-uma-chave-aleatoria-com-48-bytes
COOKIE_SECURE=false
TRUST_PROXY_HEADERS=false

# --- Origens permitidas no CORS (separadas por vírgula) ---
ALLOWED_ORIGINS=http://localhost:8081,https://localhost,capacitor://localhost

# --- Banco de Dados (Java Spring Boot & Python FastAPI) ---
# Para Docker Compose (MySQL 8):
DB_URL=jdbc:mysql://mysql:3306/crud_clientes?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=claex_user
DB_PASSWORD=troque-esta-senha-do-banco
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
MYSQL_DATABASE=crud_clientes

# Para o back-end Python (SQLite local por padrão ou MySQL via PyMySQL):
DATABASE_URL=sqlite:///./data/claex_db.sqlite

# Senha inicial das contas de demonstração criadas pelo seeder (convertida para BCrypt/PBKDF2)
CLAEX_SEED_PASSWORD=1234

# --- Proteção contra Força-Bruta no Login (HTTP 429 Too Many Requests) ---
LOGIN_MAX_ATTEMPTS=5
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15

# --- Chaves de API de Inteligência Artificial (Back-End Proxy — nunca expostas no Front-End) ---
# O front-end chama apenas /grade/ia/analisar/{id_sala}; o back-end injeta a chave no header HTTP.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
